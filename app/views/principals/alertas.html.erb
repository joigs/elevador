<div class="max-w-8xl mx-auto px-4 sm:px-6 lg:px-8 my-8">
  <div class="flex items-center justify-start mb-6">
    <%= link_to "Volver a #{@principal.name}",
                principal_path(@principal),
                class: "inline-flex items-center px-4 py-2 text-base leading-6 font-medium rounded-md text-blue-400 bg-gray-800 hover:bg-blue-800 hover:text-white transition duration-150 ease-in-out" %>
  </div>

  <div class="bg-gray-900 py-6 px-8 shadow-lg rounded-lg text-center mb-6">
    <h1 class="text-2xl font-bold text-white">Certificaciones que requieren atención</h1>
    <p class="text-gray-400"><%= @principal.name %></p>
  </div>

  <div class="mb-6 flex flex-wrap gap-3 justify-center">
    <%= link_to "Todas",
                alertas_principal_path(@principal),
                class: "px-4 py-2 rounded #{@filtro.nil? ? 'bg-blue-500 text-white' : 'bg-gray-600 text-gray-200'} hover:bg-blue-600 transition duration-300" %>
    <% @alertas.each do |clave, alerta| %>
      <%= link_to "#{alerta[:titulo]} (#{alerta[:count]})",
                  alertas_principal_path(@principal, filtro: clave),
                  class: "px-4 py-2 rounded #{@filtro == clave ? 'bg-blue-500 text-white' : 'bg-gray-600 text-gray-200'} hover:bg-blue-600 transition duration-300" %>
    <% end %>
  </div>

  <div class="bg-gray-800 shadow overflow-hidden sm:rounded-md">
    <% if @inspections.empty? %>
      <div class="p-10 text-center">
        <p class="text-gray-300">No hay certificaciones que requieran atención.</p>
      </div>
    <% else %>
      <div class="overflow-x-auto p-4">
        <table class="table-auto w-full text-white">
          <thead class="bg-gray-800">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider">N° Inspección</th>
            <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider">Activo</th>
            <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider">Clasificación</th>
            <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider">Dirección</th>
            <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider">Resultado</th>
            <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider">Fecha límite</th>
            <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider">Estado</th>
            <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider">Acciones</th>
          </tr>
          </thead>
          <tbody class="divide-y divide-gray-700">
          <% @inspections.each do |inspection| %>
            <% ending = inspection.report&.ending %>
            <% dias = ending ? (ending - Time.zone.today).to_i : nil %>
            <tr class="bg-gray-800">
              <td class="px-4 py-4">
                <%= link_to inspection.number, inspection_path(inspection), class: "text-blue-400 hover:text-blue-600" %>
              </td>
              <td class="px-4 py-4 whitespace-normal break-words">
                <%= link_to inspection.item&.identificador, item_path(inspection.item), class: "text-blue-400 hover:text-blue-600" %>
              </td>
              <td class="px-4 py-4 whitespace-normal break-words"><%= inspection.item&.group&.name %></td>
              <td class="px-4 py-4 whitespace-normal break-words"><%= inspection.place %></td>
              <td class="px-4 py-4 whitespace-normal break-words"><%= inspection.result %></td>
              <td class="px-4 py-4 whitespace-nowrap"><%= format_date(ending) %></td>
              <td class="px-4 py-4 whitespace-nowrap">
                <% if dias.nil? %>
                  <span class="text-gray-500">—</span>
                <% elsif dias < 0 %>
                  <span class="px-2 py-1 rounded text-xs font-bold bg-red-500/20 text-red-400">
                    Vencida hace <%= dias.abs %> <%= dias.abs == 1 ? "día" : "días" %>
                  </span>
                <% elsif dias == 0 %>
                  <span class="px-2 py-1 rounded text-xs font-bold bg-red-500/20 text-red-400">Vence hoy</span>
                <% else %>
                  <span class="px-2 py-1 rounded text-xs font-bold bg-yellow-500/20 text-yellow-400">
                    <%= dias %> <%= dias == 1 ? "día" : "días" %>
                  </span>
                <% end %>
              </td>
              <td class="px-4 py-4">
                <%= link_to "Ver inspección", inspection_path(inspection), class: "text-blue-400 hover:text-blue-600" %>
              </td>
            </tr>
          <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>
</div>