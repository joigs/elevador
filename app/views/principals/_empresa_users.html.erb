<div class="p-6" data-controller="table-filter">
  <% if @empresa_users.empty? %>
    <p class="text-gray-300 text-center">No hay usuarios registrados para esta empresa.</p>
  <% else %>
    <div class="mb-4 flex items-center gap-2">
      <input type="search"
             placeholder="Buscar por nombre de usuario, nombre real o correo"
             data-table-filter-target="input"
             data-action="input->table-filter#filter"
             class="w-full max-w-md px-3 py-2 bg-gray-700 text-white placeholder-gray-400 border border-gray-600 rounded-md focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
      <button type="button"
              data-action="click->table-filter#clear"
              class="px-3 py-2 rounded bg-gray-600 text-white text-sm hover:bg-gray-500">
        Limpiar
      </button>
    </div>

    <div class="overflow-x-auto">
      <table class="table-auto w-full text-white">
        <thead class="bg-gray-800">
        <tr>
          <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider">Usuario</th>
          <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider">Nombre</th>
          <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider">Email</th>
          <th class="px-4 py-3 text-center text-xs font-medium uppercase tracking-wider">Activo</th>
          <th class="px-4 py-3 text-center text-xs font-medium uppercase tracking-wider">Admin de<br>empresa</th>
          <th class="px-4 py-3 text-center text-xs font-medium uppercase tracking-wider">Recibe<br>correos</th>
          <th class="px-4 py-3 text-center text-xs font-medium uppercase tracking-wider">Acciones</th>
        </tr>
        </thead>
        <tbody class="divide-y divide-gray-700">
        <% @empresa_users.each do |user| %>
          <%= render "principals/empresa_user_row", user: user, principal: @principal %>
        <% end %>
        </tbody>
      </table>
    </div>

    <p data-table-filter-target="empty"
       class="hidden text-gray-300 text-center mt-6">
      No hay usuarios que coincidan con tu búsqueda.
    </p>
  <% end %>
</div>