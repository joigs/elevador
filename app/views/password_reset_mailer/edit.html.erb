<div class="max-w-md mx-auto px-4 my-8">
  <div class="bg-gray-900 text-white p-6 rounded-lg shadow-md">
    <h1 class="text-2xl font-bold mb-4">Nueva contraseña</h1>

    <%= form_with url: password_reset_path(params[:token]), method: :patch, scope: :user, class: "space-y-4" do |f| %>
      <div>
        <%= f.label :password, "Contraseña", class: "block text-gray-300" %>
        <%= f.password_field :password, required: true, maxlength: 100, class: "mt-1 block w-full px-3 py-2 bg-gray-700 text-white border border-gray-600 rounded-md focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm" %>
      </div>

      <div>
        <%= f.label :password_confirmation, "Confirmar contraseña", class: "block text-gray-300" %>
        <%= f.password_field :password_confirmation, required: true, maxlength: 100, class: "mt-1 block w-full px-3 py-2 bg-gray-700 text-white border border-gray-600 rounded-md focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm" %>
      </div>

      <%= f.submit "Guardar contraseña", class: "w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded cursor-pointer" %>
    <% end %>
  </div>
</div>